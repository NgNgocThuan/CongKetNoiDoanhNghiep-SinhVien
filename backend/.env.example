# Sao chép thành .env rồi chỉnh sửa:  cp .env.example .env
APP_NAME=Student Connect API
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# MariaDB (khớp docker-compose.yml ở thư mục gốc)
DATABASE_URL=mysql+pymysql://app:app@localhost:3306/student_connect?charset=utf8mb4

# JWT: đổi SECRET_KEY khi deploy (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-with-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# CORS: danh sách JSON
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Upload file (CV, giấy tờ doanh nghiệp)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# SMTP (để trống: không gửi được, nhật ký ghi FAILED)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@student-connect.local
SMTP_SSL=false

# AI / NLP provider: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=

# Required for Freelancer OTP; generate a random secret of at least 32 characters.
FREELANCER_OTP_SECRET=

# File scanning is disabled for the demo. Enable it only when a real gateway is configured.
FREELANCER_FILE_SCAN_ENABLED=false
FREELANCER_SCAN_GATEWAY_URL=
FREELANCER_SCAN_GATEWAY_TOKEN=
FREELANCER_WORKER_LEASE_SECONDS=120
FREELANCER_WORKER_MAX_ATTEMPTS=12

# Real payOS integration. Leave switches false until migration, keys and webhook are ready.
FREELANCER_FINANCE_ENABLED=false
PAYOS_COLLECTION_ENABLED=false
PAYOS_PAYOUT_ENABLED=false
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
PAYOS_COLLECTION_CLIENT_ID=
PAYOS_COLLECTION_API_KEY=
PAYOS_COLLECTION_CHECKSUM_KEY=
PAYOS_COLLECTION_CHANNEL=freelancer-collection
PAYOS_COLLECTION_BANK_BIN=
PAYOS_COLLECTION_ACCOUNT_NUMBER=
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=
# Full frontend URLs; redirect pages only display status fetched from the backend.
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# Full public HTTPS backend URL ending in /api/v1/webhooks/payos/collection
PAYOS_WEBHOOK_URL=
PAYOS_TIMEOUT_SECONDS=15
PAYOS_ORDER_TTL_SECONDS=900
# true when collection bank and payout treasury are separate (default).
PAYOS_PAYOUT_TREASURY_SEPARATE=true
# Alert active admins when a payout checks a wallet below this VND threshold.
# Insufficient balance always alerts, even when the threshold is zero.
PAYOS_PAYOUT_LOW_BALANCE_THRESHOLD=100000
# Generate once with scripts/configure_payos.py; retain keys with database backups.
FREELANCER_BANK_ENCRYPTION_KEY=
FREELANCER_BANK_KEY_VERSION=v1
FREELANCER_BANK_FINGERPRINT_KEY=
FREELANCER_DAILY_COLLECTION_LIMIT=200000000
FREELANCER_DAILY_PAYOUT_LIMIT=200000000
# MOU Hybrid: private server-side paths. Never expose these via VITE_*.
MOU_SCHOOL_PFX_PATH=
MOU_SCHOOL_PFX_PASSWORD=
MOU_TRUST_ROOT_PATH=
